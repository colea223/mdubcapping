# Copy this file to .env and fill in your key.
# Get a free CFBD API key at https://collegefootballdata.com/key
CFBD_API_KEY=your_key_here

# Only needed for src/pull_odds_api.py (the 3x/week Live Lines refresh,
# separate from the CFBD pipeline above). Get a free key at
# https://the-odds-api.com/ -- also add it as a GitHub Actions repo secret
# named ODDS_API_KEY so .github/workflows/odds_pull.yml can use it.
ODDS_API_KEY=

# Only needed for excel/import_bet_log.py -- pulls submissions from the
# docs/log-bet.html page (which writes straight to Firestore, project
# mountain-dub-log-bet) into the Bet Log tab. Get this by going to the
# Firebase console -> Project settings (gear icon) -> Service accounts ->
# "Generate new private key" -- it downloads a JSON file. Save it somewhere
# and point this at its path, e.g.:
#   FIREBASE_SERVICE_ACCOUNT_PATH=C:\Users\deene\Mountain Dub Handicapping\firebase-service-account.json
# Keep it out of the repo (see .gitignore) -- this key can read/write your
# whole Firebase project, unlike the public firebaseConfig in log-bet.html.
# Local-only -- never becomes a GitHub Actions secret, since only your own
# machine runs this import.
FIREBASE_SERVICE_ACCOUNT_PATH=
