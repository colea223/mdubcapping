# Copy this file to .env and fill in your key.
# Get a free CFBD API key at https://collegefootballdata.com/key
CFBD_API_KEY=your_key_here

# Only needed for src/pull_odds_api.py (the 3x/week Live Lines refresh,
# separate from the CFBD pipeline above). Get a free key at
# https://the-odds-api.com/ -- also add it as a GitHub Actions repo secret
# named ODDS_API_KEY so .github/workflows/odds_pull.yml can use it.
ODDS_API_KEY=

# Only needed for excel/import_bet_log.py -- pulls submissions from the
# docs/log-bet.html page into the Bet Log tab. Set these up by following
# google_apps_script/bet_log_webapp.gs's own setup steps: BET_WEBAPP_URL is
# your deployed Apps Script Web App's /exec URL, BET_WEBAPP_TOKEN must match
# the READ_TOKEN you picked inside that script. Local-only -- never becomes
# a GitHub Actions secret, since only your own machine runs this import.
BET_WEBAPP_URL=
BET_WEBAPP_TOKEN=
