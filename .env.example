# Copy this file to .env and fill in your key.
# Get a free CFBD API key at https://collegefootballdata.com/key
CFBD_API_KEY=your_key_here

# Only needed for src/pull_odds_api.py (the 3x/week Live Lines refresh,
# separate from the CFBD pipeline above). Get a free key at
# https://the-odds-api.com/ -- also add it as a GitHub Actions repo secret
# named ODDS_API_KEY so .github/workflows/odds_pull.yml can use it.
ODDS_API_KEY=
